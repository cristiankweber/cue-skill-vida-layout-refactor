{
  "brand": {
    "name": "Vida Hematologia / Vida Pesquisa Clínica",
    "visual_principles": [
      "medical",
      "institutional",
      "clean",
      "premium",
      "human",
      "technical",
      "low visual noise"
    ]
  },
  "colors": {
    "vida_wine": "#7A1714",
    "vida_red": "#B51F1B",
    "vida_coral": "#E43D3D",
    "vida_teal": "#008E7D",
    "vida_teal_dark": "#006F63",
    "regina_blue": "#1175B8",
    "text_primary": "#333333",
    "text_secondary": "#6B6B6B",
    "background": "#F4F4F3",
    "surface": "#FFFFFF",
    "surface_soft": "#FAFAF9",
    "border": "#E7E3DF",
    "muted": "#F0EFED",
    "success": "#178A5B",
    "warning": "#B7791F",
    "danger": "#B51F1B",
    "info": "#1175B8"
  },
  "typography": {
    "heading_family_suggestion": "Inter, Avenir Next, Roboto Condensed, system-ui, sans-serif",
    "body_family_suggestion": "Inter, Avenir Next, system-ui, sans-serif",
    "h1": {
      "size": "32-40px",
      "weight": 700,
      "line_height": "1.1"
    },
    "h2": {
      "size": "24-30px",
      "weight": 700,
      "line_height": "1.2"
    },
    "h3": {
      "size": "18-22px",
      "weight": 650,
      "line_height": "1.25"
    },
    "body": {
      "size": "14-16px",
      "weight": 400,
      "line_height": "1.5"
    },
    "label": {
      "size": "12-13px",
      "weight": 600,
      "letter_spacing": "0.02em"
    }
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "16px",
    "xl": "24px"
  },
  "spacing_scale_px": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "shadow": {
    "card": "0 8px 24px rgba(51, 51, 51, 0.06)",
    "popover": "0 16px 40px rgba(51, 51, 51, 0.12)",
    "avoid": "heavy, colored or high-blur shadows"
  },
  "component_guidelines": {
    "button_primary": {
      "background": "vida_red",
      "text": "white",
      "radius": "md",
      "use": "one primary action per view"
    },
    "button_secondary": {
      "background": "surface",
      "text": "text_primary",
      "border": "border",
      "radius": "md"
    },
    "card": {
      "background": "surface",
      "border": "border",
      "radius": "lg/xl",
      "padding": "20-32px",
      "shadow": "subtle"
    },
    "badge": {
      "style": "soft background, restrained color, short label"
    },
    "table": {
      "density": "comfortable",
      "header": "muted background or bold text",
      "actions": "group secondary actions"
    }
  }
}